{
  "name": "wordcards",
  "version": "1.1.0",
  "buildNumber": "20",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "watchman watch-del $(pwd) && watchman watch-project $(pwd) && react-native start --reset-cache --client-logs",
    "test": "jest",
    "clean": "cd android && .\\gradlew clean",
    "icons:svg:gen": "svgr --config-file src/assets/icons/svg/.svgrrc.cjs --out-dir src/assets/icons/svg/components --no-index src/assets/icons/svg/src",
    "icons:svg:register": "node scripts/generate-icon-registry.js",
    "icons:svg": "yarn icons:svg:gen && yarn icons:svg:register",
    "postinstall": "patch-package",
    "android-bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.30.3",
    "@react-native-clipboard/clipboard": "^1.15.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.1",
    "@reduxjs/toolkit": "^2.5.0",
    "add": "^2.0.6",
    "appcenter": "^5.0.2",
    "appcenter-analytics": "^5.0.2",
    "appcenter-crashes": "^5.0.2",
    "axios": "^1.12.2",
    "i18next": "^25.6.0",
    "i18next-http-backend": "^3.0.2",
    "js-base64": "^3.7.8",
    "lottie-react-native": "^7.1.0",
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-i18next": "^16.0.1",
    "react-native": "0.84.1",
    "react-native-bootsplash": "6.3.11",
    "react-native-country-flag": "^2.0.2",
    "react-native-device-info": "^14.0.2",
    "react-native-dotenv": "^3.4.11",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.5.4",
    "react-native-mmkv": "^4.3.1",
    "react-native-modal": "^13.0.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-outside-press": "^1.2.2",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.4.0",
    "react-native-shadow-2": "^7.1.1",
    "react-native-svg": "^15.10.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-unistyles": "^3.2.3",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "yandex-mobile-ads": "^7.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@svgr/cli": "^8.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  }
}
